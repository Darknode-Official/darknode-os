#!/usr/bin/env bash
# darknode-engage-mgr — manage pentest engagements — create, switch, and track the active one
set -uo pipefail
DIR="$HOME/.darknode/engagements"; mkdir -p "$DIR"
CURRENT="$DIR/.current"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
ts(){ date -u +%Y%m%d-%H%M%S; }
_cur(){ cat "$CURRENT" 2>/dev/null || echo ""; }
_cur_dir(){ local n=$(_cur); [ -n "$n" ] && echo "$DIR/$n" || echo ""; }

cmd_new(){
  local name="${1:?usage: darknode-engage-mgr new 'Engagement Name'}"
  local slug=$(echo "$name" | tr ' ' '-' | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-')
  local edir="$DIR/$slug"
  mkdir -p "$edir"/{findings,evidence,notes,scans}
  echo "$name" > "$edir/name.txt"
  echo "$(ts)" > "$edir/started.txt"
  echo "active" > "$edir/status.txt"
  echo "0" > "$edir/hours.txt"
  touch "$edir/scope.txt" "$edir/findings.log"
  echo "$slug" > "$CURRENT"
  g "  Created engagement: $name"
  echo "  Directory: $edir"
  echo "  Set as current engagement."
}

cmd_scope(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement. Run: darknode-engage-mgr new 'Name'"; return 1; }
  local action="${1:-show}"; shift 2>/dev/null || true
  case "$action" in
    add) local target="${1:?usage: scope add <target>}"; echo "$target" >> "$d/scope.txt"; g "  Added to scope: $target" ;;
    show) c "Scope for: $(cat "$d/name.txt")"; echo ""; cat "$d/scope.txt" 2>/dev/null | sed 's/^/  /' ;;
    *) echo "  Usage: scope add <target> | scope show" ;;
  esac
}

cmd_finding(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement."; return 1; }
  local sev="${1:?usage: finding <critical|high|medium|low|info> 'description'}"
  local desc="${2:?usage: finding $sev 'description'}"
  local id=$(wc -l < "$d/findings.log" 2>/dev/null || echo 0)
  id=$((id+1))
  echo "F-$id|$sev|$(ts)|$desc" >> "$d/findings.log"
  local color="\e[0m"
  case "$sev" in critical) color="\e[31m";; high) color="\e[33m";; medium) color="\e[36m";; esac
  printf "  ${color}[F-$id] $sev: $desc\e[0m\n"
}

cmd_hours(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement."; return 1; }
  local action="${1:-show}"; shift 2>/dev/null || true
  case "$action" in
    log) local h="${1:?usage: hours log <number>}"; local cur=$(cat "$d/hours.txt"); echo "$((cur+h))" > "$d/hours.txt"; g "  Logged $h hours (total: $((cur+h)))" ;;
    show|*) echo "  Hours logged: $(cat "$d/hours.txt")" ;;
  esac
}

cmd_status(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement."; return 1; }
  c "Engagement: $(cat "$d/name.txt")"
  echo "  Status:   $(cat "$d/status.txt")"
  echo "  Started:  $(cat "$d/started.txt")"
  echo "  Hours:    $(cat "$d/hours.txt")"
  echo "  Scope:    $(wc -l < "$d/scope.txt" 2>/dev/null || echo 0) targets"
  echo "  Findings: $(wc -l < "$d/findings.log" 2>/dev/null || echo 0)"
  local crits highs
  crits=$(grep -c '|critical|' "$d/findings.log" 2>/dev/null) || crits=0
  highs=$(grep -c '|high|' "$d/findings.log" 2>/dev/null) || highs=0
  [ "$crits" -gt 0 ] && r "  Critical: $crits"
  [ "$highs" -gt 0 ] && y "  High: $highs"
}

cmd_list(){
  c "All Engagements"
  echo ""
  local cur=$(_cur)
  for d in "$DIR"/*/; do
    [ -d "$d" ] || continue
    local name=$(cat "$d/name.txt" 2>/dev/null || basename "$d")
    local status=$(cat "$d/status.txt" 2>/dev/null || echo "?")
    local findings=$(wc -l < "$d/findings.log" 2>/dev/null || echo 0)
    local slug=$(basename "$d")
    local marker=""; [ "$slug" = "$cur" ] && marker=" (CURRENT)"
    printf "  %-30s %-10s %s findings%s\n" "$name" "$status" "$findings" "$marker"
  done
}

cmd_close(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement."; return 1; }
  echo "closed" > "$d/status.txt"
  echo "$(ts)" > "$d/closed.txt"
  g "  Engagement closed: $(cat "$d/name.txt")"
  rm -f "$CURRENT"
}

cmd_export(){
  local d=$(_cur_dir); [ -z "$d" ] && { r "No active engagement."; return 1; }
  local name=$(cat "$d/name.txt")
  local out="$d/report-$(ts).md"
  {
    echo "# Penetration Test Report: $name"
    echo "_Generated: $(date -u)_"
    echo ""
    echo "## Engagement Details"
    echo "- Status: $(cat "$d/status.txt")"
    echo "- Started: $(cat "$d/started.txt")"
    echo "- Hours: $(cat "$d/hours.txt")"
    echo ""
    echo "## Scope"
    cat "$d/scope.txt" 2>/dev/null | sed 's/^/- /'
    echo ""
    echo "## Findings"
    echo ""
    while IFS='|' read -r id sev ts desc; do
      echo "### $id ($sev)"
      echo "- Date: $ts"
      echo "- Description: $desc"
      echo ""
    done < "$d/findings.log" 2>/dev/null
  } > "$out"
  g "  Report exported: $out"
}

usage(){ cat << 'U'
  darknode-engage-mgr — manage pentest engagements

  Commands:
    new <name>           Start new engagement
    scope add <target>   Add target to scope
    scope show           Show current scope
    finding <sev> <desc> Add a finding (critical/high/medium/low/info)
    hours log <n>        Log hours worked
    status               Show engagement status
    list                 List all engagements
    close                Close current engagement
    export               Export engagement report
U
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  new) cmd_new "$@" ;; scope) cmd_scope "$@" ;; finding) cmd_finding "$@" ;;
  hours) cmd_hours "$@" ;; status) cmd_status ;; list) cmd_list ;;
  close) cmd_close ;; export) cmd_export ;; help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
