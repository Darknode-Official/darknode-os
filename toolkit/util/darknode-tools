#!/usr/bin/env bash
# darknode-tools — discover, search, and launch the Darknode custom toolkit
#   darknode-tools               overview: tool counts by category
#   darknode-tools list          list every Darknode tool with a one-line description
#   darknode-tools <category>    list one category (recon|exploit|post|defense|util)
#   darknode-tools search <q>    fuzzy-search names and descriptions
#   darknode-tools info <tool>   show a tool's description + install status
#   darknode-tools run <tool> …  run a tool by name (passes remaining args)
set -uo pipefail

c(){ printf '\e[1;36m%s\e[0m' "$*"; }
g(){ printf '\e[32m%s\e[0m' "$*"; }
r(){ printf '\e[31m%s\e[0m' "$*"; }
y(){ printf '\e[33m%s\e[0m' "$*"; }
dim(){ printf '\e[2m%s\e[0m' "$*"; }

# Registry: name|category  (generated from the toolkit source tree)
