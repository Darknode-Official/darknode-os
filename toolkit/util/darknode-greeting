#!/usr/bin/env bash
# darknode-greeting — Darknode OS terminal greeting shown on each new shell.
# Must NEVER error or produce extra output — runs in .bashrc on every shell.

C='\e[36m'    # accent (cyan)
D='\e[2m'     # dim
R='\e[0m'     # reset

# System info — all with fallbacks, no unset-var errors.
. /etc/os-release 2>/dev/null
cpu=$(grep 'model name' /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs 2>/dev/null | cut -c1-40)
ram=$(free -h 2>/dev/null | awk '/^Mem:/{print $3 "/" $2}')
disk=$(df -h / 2>/dev/null | awk 'NR==2{print $3 "/" $2}')
ip=$(hostname -I 2>/dev/null | awk '{print $1}')
up=$(uptime -p 2>/dev/null | sed 's/up //')

# Version from the branded PRETTY_NAME ("Darknode OS 1.0"); base VERSION_ID is
# left untouched by the rebrand, so don't use it here.
ver=$(printf '%s' "${PRETTY_NAME:-}" | grep -oE '[0-9]+(\.[0-9]+)?' | head -1)
printf "\n  ${C}Darknode OS${R} ${D}%s${R}   security workstation\n\n" "${ver:-1.0}"
printf "  ${D}host${R}  %s\n" "$(hostname 2>/dev/null)"
printf "  ${D}cpu${R}   %s\n" "${cpu:-unknown}"
printf "  ${D}mem${R}   %s    ${D}disk${R}  %s    ${D}up${R}  %s\n" "${ram:-?}" "${disk:-?}" "${up:-?}"
printf "  ${D}ip${R}    %s\n\n" "${ip:-offline}"
printf "  Run ${C}darknode-tools${R} to explore the toolkit, ${C}darknode-ask${R} for help.\n\n"
