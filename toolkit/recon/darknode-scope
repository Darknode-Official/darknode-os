#!/usr/bin/env bash
# darknode-scope — engagement authorization guard — enforce your in-scope targets
# Darknode's offensive tools refuse to touch anything outside them. Unique to Darknode OS:
# it turns "only test what you're authorized to" from a sticky-note into an enforced rule.
#
#   darknode-scope add 10.0.0.0/24 target.example.com   # authorize
#   darknode-scope list | rm <t> | clear
#   darknode-scope check <target>                       # is it allowed?
#   darknode-scope guard  <target>                      # exit 0 in-scope / 3 out  (used by tools)
set -uo pipefail
CFG="${DARKNODE_SCOPE:-$HOME/.config/darknode/scope}"; mkdir -p "$(dirname "$CFG")"; touch "$CFG"
cmd="${1:-list}"; [ $# -gt 0 ] && shift

in_scope(){ # 0 = target ($1) matches an entry in $CFG (exact host, domain suffix, or CIDR)
  python3 - "$1" "$CFG" <<'PY'
import sys, ipaddress
t = sys.argv[1].strip().lower()
try: lines = open(sys.argv[2]).read().splitlines()
except Exception: lines = []
def match(t, e):
    e = e.strip().lower()
    if not e or e.startswith('#'): return False
    if t == e or t.endswith('.' + e): return True
    try:
        net = ipaddress.ip_network(e, strict=False)
    except Exception:
        return False  # e is a host/domain, not an IP range — handled above
    try:
        # the target may be a single IP or a CIDR range; in-scope only if it is
        # fully contained in the authorized network (a wider range is refused).
        return ipaddress.ip_network(t, strict=False).subnet_of(net)
    except Exception:
        return False
sys.exit(0 if any(match(t, e) for e in lines) else 1)
PY
}

case "$cmd" in
  add)   for t in "$@"; do grep -qxF "$t" "$CFG" 2>/dev/null || echo "$t" >> "$CFG"; echo "[+] in scope: $t"; done ;;
  rm|del) for t in "$@"; do grep -vxF "$t" "$CFG" > "$CFG.tmp" 2>/dev/null || true; mv "$CFG.tmp" "$CFG"; echo "[-] removed: $t"; done ;;
  clear) : > "$CFG"; echo "[*] scope cleared" ;;
  list)  echo "# Darknode engagement scope — $CFG"
         if [ -s "$CFG" ]; then grep -vE '^\s*$' "$CFG"; else echo "(empty — add targets:  darknode-scope add 10.0.0.0/24 example.com)"; fi ;;
  check) t="${1:?usage: darknode-scope check <target>}"
         if in_scope "$t"; then echo "IN SCOPE:  $t"; else echo "OUT OF SCOPE:  $t"; exit 3; fi ;;
  guard) t="${1:?usage: darknode-scope guard <target>}"
         if [ ! -s "$CFG" ]; then
           echo "[darknode-scope] no scope defined — allowing (set one with: darknode-scope add <target>)" >&2; exit 0
         elif in_scope "$t"; then exit 0
         else echo "[darknode-scope] REFUSED — $t is out of scope. Authorize it:  darknode-scope add $t" >&2; exit 3; fi ;;
  *) echo "usage: darknode-scope {add|rm|list|clear|check|guard} [targets...]"; exit 2 ;;
esac
