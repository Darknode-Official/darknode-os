#!/usr/bin/env bash
# darknode-cloud — cloud pentesting suite for AWS, Azure, and GCP
set -uo pipefail
OUT_DIR="$HOME/.darknode/cloud"
mkdir -p "$OUT_DIR"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
_has(){ command -v "$1" >/dev/null 2>&1; }

cmd_aws(){
  local sub="${1:-enum}"; shift 2>/dev/null || true
  _has aws || { r "awscli not installed. pip install awscli"; return 1; }
  case "$sub" in
    enum)
      c "AWS Enumeration"
      echo ""
      c "=== Identity ==="
      aws sts get-caller-identity 2>/dev/null || { r "No AWS credentials configured"; return 1; }
      echo ""
      c "=== S3 Buckets ==="
      aws s3 ls 2>/dev/null | head -20
      echo ""
      c "=== EC2 Instances ==="
      aws ec2 describe-instances --query 'Reservations[].Instances[].{ID:InstanceId,Type:InstanceType,State:State.Name,IP:PublicIpAddress}' --output table 2>/dev/null
      echo ""
      c "=== IAM Users ==="
      aws iam list-users --query 'Users[].{User:UserName,Created:CreateDate}' --output table 2>/dev/null
      echo ""
      c "=== Lambda Functions ==="
      aws lambda list-functions --query 'Functions[].{Name:FunctionName,Runtime:Runtime}' --output table 2>/dev/null
      ;;
    s3)
      local action="${1:-scan}"
      c "AWS S3 $action"
      if [ "$action" = "scan" ]; then
        local bucket="${2:-}"
        if [ -n "$bucket" ]; then
          aws s3 ls "s3://$bucket" --no-sign-request 2>&1
        else
          c "Scanning your buckets for public access..."
          aws s3api list-buckets --query 'Buckets[].Name' --output text 2>/dev/null | tr '\t' '\n' | while read -r b; do
            acl=$(aws s3api get-bucket-acl --bucket "$b" 2>/dev/null | grep -c "AllUsers\|AuthenticatedUsers")
            [ "$acl" -gt 0 ] && r "  PUBLIC: $b" || g "  private: $b"
          done
        fi
      fi
      ;;
    iam)
      c "AWS IAM Audit"
      echo ""
      c "=== Users with console access ==="
      aws iam list-users --query 'Users[].UserName' --output text 2>/dev/null | tr '\t' '\n' | while read -r u; do
        profile=$(aws iam get-login-profile --user-name "$u" 2>/dev/null && echo "YES" || echo "no")
        mfa=$(aws iam list-mfa-devices --user-name "$u" --query 'MFADevices' --output text 2>/dev/null)
        [ -n "$mfa" ] && mfa_status="MFA" || mfa_status="NO-MFA"
        echo "  $u  console:$profile  $mfa_status"
      done
      echo ""
      c "=== Policies with admin ==="
      aws iam list-policies --scope Local --query 'Policies[].{Name:PolicyName,Arn:Arn}' --output text 2>/dev/null | while read -r name arn; do
        doc=$(aws iam get-policy-version --policy-arn "$arn" --version-id "$(aws iam get-policy --policy-arn "$arn" --query 'Policy.DefaultVersionId' --output text 2>/dev/null)" --query 'PolicyVersion.Document' --output text 2>/dev/null)
        echo "$doc" | grep -q '"Action": "\*"' && r "  ADMIN: $name" || dim "  $name"
      done
      ;;
    *) echo "  Usage: darknode-cloud aws [enum|s3 scan|iam]" ;;
  esac
}

cmd_azure(){
  local sub="${1:-enum}"; shift 2>/dev/null || true
  _has az || { r "azure-cli not installed. pip install azure-cli"; return 1; }
  case "$sub" in
    enum)
      c "Azure Enumeration"
      echo ""
      az account show 2>/dev/null || { r "Not logged in. Run: az login"; return 1; }
      echo ""
      c "=== Resource Groups ==="
      az group list --query '[].{Name:name,Location:location}' -o table 2>/dev/null
      echo ""
      c "=== VMs ==="
      az vm list --query '[].{Name:name,Size:hardwareProfile.vmSize,OS:storageProfile.osDisk.osType}' -o table 2>/dev/null
      echo ""
      c "=== Storage Accounts ==="
      az storage account list --query '[].{Name:name,Kind:kind}' -o table 2>/dev/null
      ;;
    *) echo "  Usage: darknode-cloud azure [enum]" ;;
  esac
}

cmd_gcp(){
  local sub="${1:-enum}"; shift 2>/dev/null || true
  _has gcloud || { r "gcloud not installed."; return 1; }
  case "$sub" in
    enum)
      c "GCP Enumeration"
      echo ""
      gcloud auth list 2>/dev/null
      echo ""
      c "=== Projects ==="
      gcloud projects list 2>/dev/null
      echo ""
      c "=== Compute Instances ==="
      gcloud compute instances list 2>/dev/null
      echo ""
      c "=== Storage Buckets ==="
      gsutil ls 2>/dev/null
      ;;
    *) echo "  Usage: darknode-cloud gcp [enum]" ;;
  esac
}

cmd_scan_all(){
  c "Multi-Cloud Scan"
  echo ""
  _has aws && { cmd_aws enum 2>/dev/null; echo ""; } || dim "  AWS: not configured"
  _has az && { cmd_azure enum 2>/dev/null; echo ""; } || dim "  Azure: not configured"
  _has gcloud && { cmd_gcp enum 2>/dev/null; echo ""; } || dim "  GCP: not configured"
}

usage(){
  cat << 'EOF'

  darknode-cloud — cloud pentesting suite

  Commands:
    aws enum         Enumerate AWS (identity, S3, EC2, IAM, Lambda)
    aws s3 scan      Scan S3 buckets for public access
    aws iam          IAM audit (console access, MFA, admin policies)
    azure enum       Enumerate Azure (resource groups, VMs, storage)
    gcp enum         Enumerate GCP (projects, instances, buckets)
    scan-all         Run enumeration on all configured clouds

  Prerequisites: awscli, azure-cli, gcloud SDK (with credentials configured)

EOF
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  aws)      cmd_aws "$@" ;;
  azure)    cmd_azure "$@" ;;
  gcp)      cmd_gcp "$@" ;;
  scan-all) cmd_scan_all ;;
  help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
