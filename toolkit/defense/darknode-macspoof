#!/usr/bin/env bash
# darknode-macspoof — randomize or restore a network interface's MAC address
# Randomize (or restore) the MAC of an interface. Default: first non-lo iface.
set -uo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
command -v macchanger >/dev/null || { echo "[!] macchanger not installed (apt install macchanger)"; exit 1; }
IF="${2:-$(ip -o link show | awk -F': ' '$2!="lo"{print $2; exit}')}"
[ -n "$IF" ] || { echo "[!] no network interface found"; exit 1; }
case "${1:-random}" in
  random) ip link set "$IF" down; macchanger -r "$IF"; ip link set "$IF" up; echo "[+] $IF randomized";;
  restore) ip link set "$IF" down; macchanger -p "$IF"; ip link set "$IF" up; echo "[+] $IF restored";;
  show) macchanger -s "$IF";;
  *) echo "usage: darknode-macspoof random|restore|show [iface]";;
esac
