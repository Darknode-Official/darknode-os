#!/usr/bin/env bash
set -uo pipefail
# darknode-classify — malware static analysis and classification

CLS_DIR="$HOME/.darknode/classify"
mkdir -p "$CLS_DIR"

c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

cmd_scan(){
  local file="${1:?usage: darknode-classify scan <file>}"
  [ -f "$file" ] || { r "File not found: $file"; return 1; }
  c "Malware Analysis: $(basename "$file")"
  echo ""

  echo "  File: $(basename "$file")"
  echo "  Size: $(du -h "$file" | cut -f1)"
  echo "  Type: $(file -b "$file")"
  echo "  MD5:  $(md5sum "$file" | cut -d' ' -f1)"
  echo "  SHA1: $(sha1sum "$file" | cut -d' ' -f1)"
  echo "  SHA256: $(sha256sum "$file" | cut -d' ' -f1)"
  echo ""

  # Entropy
  cmd_entropy "$file" 2>/dev/null
  echo ""

  # Strings summary
  local str_count; str_count=$(strings -n 6 "$file" 2>/dev/null | wc -l)
  echo "  Strings (len>=6): $str_count"

  # Suspicious indicators
  dim "Suspicious indicators:"
  local suspicious=0
  strings "$file" 2>/dev/null | grep -qiE 'cmd\.exe|powershell|/bin/sh|/bin/bash' && { y "  [!] Shell references found"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'http://|https://|ftp://' && { y "  [!] URLs found"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'password|credential|token|api.key|secret' && { y "  [!] Credential-related strings"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'CreateRemoteThread|VirtualAllocEx|WriteProcessMemory' && { r "  [!!] Process injection API calls"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'RegSetValue|HKEY_|CurrentVersion\\Run' && { r "  [!!] Registry persistence indicators"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'socket|connect|bind|listen|accept|recv|send' && { y "  [!] Network socket operations"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'crypt|encrypt|decrypt|aes|rsa|base64' && { y "  [!] Cryptographic operations"; suspicious=$((suspicious+1)); }
  strings "$file" 2>/dev/null | grep -qiE 'kernel32|ntdll|advapi32|ws2_32' && { y "  [!] Windows API imports"; suspicious=$((suspicious+1)); }
  [ "$suspicious" -eq 0 ] && g "  No obvious suspicious indicators"
  echo ""
  echo "  Suspicion score: $suspicious/8"

  # ClamAV scan if available
  if command -v clamscan >/dev/null 2>&1; then
    echo ""
    dim "ClamAV scan:"
    clamscan --no-summary "$file" 2>/dev/null | sed 's/^/  /'
  fi
}

cmd_strings(){
  local file="${1:?usage: darknode-classify strings <file>}"
  [ -f "$file" ] || { r "File not found"; return 1; }
  c "String Analysis: $(basename "$file")"
  echo ""
  dim "=== URLs ==="
  strings "$file" 2>/dev/null | grep -oiE 'https?://[^ "]+' | sort -u | head -20 | sed 's/^/  /'
  echo ""
  dim "=== IP Addresses ==="
  strings "$file" 2>/dev/null | grep -oE '\b[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b' | sort -u | head -20 | sed 's/^/  /'
  echo ""
  dim "=== Email Addresses ==="
  strings "$file" 2>/dev/null | grep -oiE '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' | sort -u | head -10 | sed 's/^/  /'
  echo ""
  dim "=== File Paths ==="
  strings "$file" 2>/dev/null | grep -oE '([A-Z]:\\[^ ]+|/[a-z]+/[^ ]+)' | sort -u | head -20 | sed 's/^/  /'
  echo ""
  dim "=== Registry Keys ==="
  strings "$file" 2>/dev/null | grep -oiE 'HKEY_[A-Z_]+\\[^ ]+' | sort -u | head -10 | sed 's/^/  /'
  echo ""
  dim "=== Suspicious Keywords ==="
  strings "$file" 2>/dev/null | grep -iE 'password|admin|root|shell|inject|exploit|payload|backdoor|trojan|keylog|ransom' | sort -u | head -15 | sed 's/^/  /'
}

cmd_entropy(){
  local file="${1:?usage: darknode-classify entropy <file>}"
  [ -f "$file" ] || { r "File not found"; return 1; }
  local entropy
  entropy=$(FILE="$file" python3 -c "
import math,sys,os
data=open(os.environ['FILE'],'rb').read()
if not data: print('0.0'); sys.exit()
freq={}
for b in data: freq[b]=freq.get(b,0)+1
e=0
for count in freq.values():
    p=count/len(data)
    e-=p*math.log2(p)
print(f'{e:.2f}')
" 2>/dev/null || echo "?")
  echo "  Entropy: $entropy / 8.00"
  if python3 -c "exit(0 if float('$entropy')>7.0 else 1)" 2>/dev/null; then
    r "  HIGH entropy — likely packed, encrypted, or compressed"
  elif python3 -c "exit(0 if float('$entropy')>5.5 else 1)" 2>/dev/null; then
    y "  MODERATE entropy — could be normal compiled code"
  else
    g "  LOW entropy — plaintext or simple data"
  fi
}

cmd_yara(){
  local file="${1:?usage: darknode-classify yara <file>}"
  [ -f "$file" ] || { r "File not found"; return 1; }
  if ! command -v yara >/dev/null 2>&1; then
    r "YARA not installed. Install: apt install yara"
    return 1
  fi
  c "YARA Scan: $(basename "$file")"
  local rules_dir="/usr/share/yara-rules"
  if [ -d "$rules_dir" ]; then
    for rule in "$rules_dir"/*.yar "$rules_dir"/**/*.yar; do
      [ -f "$rule" ] || continue
      yara "$rule" "$file" 2>/dev/null | sed 's/^/  /'
    done
  else
    dim "  No YARA rules found at $rules_dir"
    dim "  Download: git clone https://github.com/Yara-Rules/rules $rules_dir"
  fi
}

cmd_compare(){
  local f1="${1:?usage: darknode-classify compare <file1> <file2>}"
  local f2="${2:?provide second file}"
  c "Similarity Analysis"
  echo "  File 1: $(basename "$f1") ($(du -h "$f1" | cut -f1))"
  echo "  File 2: $(basename "$f2") ($(du -h "$f2" | cut -f1))"
  echo ""
  echo "  SHA256 match: $([ "$(sha256sum "$f1" | cut -d' ' -f1)" = "$(sha256sum "$f2" | cut -d' ' -f1)" ] && echo YES || echo NO)"
  local ssdeep1 ssdeep2
  if command -v ssdeep >/dev/null 2>&1; then
    ssdeep1=$(ssdeep "$f1" 2>/dev/null | tail -1)
    ssdeep2=$(ssdeep "$f2" 2>/dev/null | tail -1)
    echo "  Fuzzy hash similarity: $(ssdeep -l -d "$f1" "$f2" 2>/dev/null | tail -1 || echo 'N/A')"
  fi
  local shared; shared=$(comm -12 <(strings "$f1" 2>/dev/null | sort -u) <(strings "$f2" 2>/dev/null | sort -u) | wc -l)
  local total1; total1=$(strings "$f1" 2>/dev/null | sort -u | wc -l)
  local total2; total2=$(strings "$f2" 2>/dev/null | sort -u | wc -l)
  echo "  Shared strings: $shared (file1: $total1, file2: $total2)"
}

cmd_report(){
  c "Classification Reports"
  ls -lht "$CLS_DIR"/ 2>/dev/null | head -20 | sed 's/^/  /'
}

usage(){ cat << 'U'

  darknode-classify — malware static analysis and classification

  Commands:
    scan <file>            Full analysis (hashes, entropy, strings, indicators)
    strings <file>         Extract + categorize strings (URLs, IPs, paths, registry)
    entropy <file>         Entropy analysis (detect packing/encryption)
    yara <file>            Match against YARA rules
    compare <f1> <f2>      Similarity analysis between two files
    report                 Show past analysis reports

U
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  scan) cmd_scan "$@" ;; strings) cmd_strings "$@" ;; entropy) cmd_entropy "$@" ;;
  yara) cmd_yara "$@" ;; compare) cmd_compare "$@" ;; report) cmd_report ;;
  help|--help|-h) usage ;; *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
