#!/usr/bin/env bash
# darknode-monitor — network traffic monitor
set -uo pipefail
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

cmd_live(){
  c "Live Network Monitor (Ctrl+C to stop)"
  echo ""
  while true; do
    clear
    c "=== Active Connections ==="
    ss -tlnp 2>/dev/null | head -15
    echo ""
    c "=== Established ==="
    ss -tn state established 2>/dev/null | awk 'NR>1{print "  "$4" <-> "$5}' | head -10
    echo ""
    c "=== Bandwidth ==="
    if command -v ifstat >/dev/null 2>&1; then
      ifstat -t 1 1 2>/dev/null
    else
      cat /proc/net/dev 2>/dev/null | awk 'NR>2{printf "  %-10s RX: %10d MB  TX: %10d MB\n",$1,$2/1048576,$10/1048576}'
    fi
    echo ""
    c "=== DNS Queries (last 5) ==="
    if [ -f /var/log/syslog ]; then
      grep -i "query\[" /var/log/syslog 2>/dev/null | tail -5 | awk '{print "  "$0}' || dim "  (no DNS log)"
    fi
    dim "  Refreshing in 5s..."
    sleep 5
  done
}

cmd_connections(){
  c "Network Connections"
  echo ""
  c "=== Listening ==="
  ss -tlnp 2>/dev/null
  echo ""
  c "=== Established ==="
  ss -tn state established 2>/dev/null
  echo ""
  c "=== UDP ==="
  ss -ulnp 2>/dev/null
}

cmd_bandwidth(){
  c "Bandwidth Monitor"
  if command -v iftop >/dev/null 2>&1; then
    sudo iftop 2>/dev/null
  elif command -v nload >/dev/null 2>&1; then
    nload 2>/dev/null
  else
    y "Real-time bandwidth monitoring:"
    while true; do
      local rx1=$(cat /sys/class/net/*/statistics/rx_bytes 2>/dev/null | paste -sd+ | bc)
      local tx1=$(cat /sys/class/net/*/statistics/tx_bytes 2>/dev/null | paste -sd+ | bc)
      sleep 1
      local rx2=$(cat /sys/class/net/*/statistics/rx_bytes 2>/dev/null | paste -sd+ | bc)
      local tx2=$(cat /sys/class/net/*/statistics/tx_bytes 2>/dev/null | paste -sd+ | bc)
      printf "\r  RX: %6d KB/s  TX: %6d KB/s" $(( (rx2-rx1)/1024 )) $(( (tx2-tx1)/1024 ))
    done
  fi
}

cmd_beacons(){
  c "Beacon Detection"
  dim "Analyzing connection patterns for regular-interval beaconing..."
  echo ""
  ss -tn state established 2>/dev/null | awk 'NR>1{print $5}' | cut -d: -f1 | sort | uniq -c | sort -rn | head -10 | while read -r count ip; do
    if [ "$count" -gt 3 ]; then
      y "  $count connections to $ip (possible C2 beacon)"
    else
      dim "  $count connections to $ip"
    fi
  done
  echo ""
  dim "For deep analysis, capture traffic: tcpdump -i any -w capture.pcap"
}

cmd_alerts(){
  c "Security Alerts"
  echo ""
  c "=== Failed SSH logins (last 24h) ==="
  if [ -f /var/log/auth.log ]; then
    grep "Failed password" /var/log/auth.log 2>/dev/null | awk '{print $11}' | sort | uniq -c | sort -rn | head -10
  elif [ -f /var/log/secure ]; then
    grep "Failed password" /var/log/secure 2>/dev/null | awk '{print $11}' | sort | uniq -c | sort -rn | head -10
  else
    dim "  No auth log found"
  fi
  echo ""
  c "=== New listening ports ==="
  ss -tlnp 2>/dev/null | awk 'NR>1{print "  "$4" "$6}'
  echo ""
  c "=== Suspicious processes ==="
  ps aux --no-headers 2>/dev/null | awk '$3>50{print "  HIGH CPU: "$0}' | head -5
  ps aux --no-headers 2>/dev/null | awk '$4>50{print "  HIGH MEM: "$0}' | head -5
}

cmd_capture(){
  local iface="${1:-any}"; local output="${2:-$HOME/.darknode/capture-$(date +%s).pcap}"
  mkdir -p "$(dirname "$output")"
  c "Packet capture: interface=$iface -> $output"
  y "Ctrl+C to stop"
  sudo tcpdump -i "$iface" -w "$output" -nn 2>&1
  if [ -s "$output" ]; then g "Capture saved: $output"; else r "No packets captured (nothing written to $output)"; fi
}

usage(){
  cat << 'EOF'

  darknode-monitor — network traffic monitor

  Commands:
    live                 Live dashboard (connections, bandwidth, DNS)
    connections          Show all network connections
    bandwidth            Bandwidth monitor
    beacons              Detect C2 beaconing patterns
    alerts               Security alerts (failed logins, new ports)
    capture [iface] [f]  Packet capture to file

EOF
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  live)        cmd_live ;;
  connections) cmd_connections ;;
  bandwidth)   cmd_bandwidth ;;
  beacons)     cmd_beacons ;;
  alerts)      cmd_alerts ;;
  capture)     cmd_capture "$@" ;;
  help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
