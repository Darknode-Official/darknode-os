#!/usr/bin/env bash
# darknode-harden — system hardening automation
set -uo pipefail
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
PASS=0; FAIL=0; WARN=0
_ok(){ g "  [PASS] $*"; PASS=$((PASS+1)); }
_fail(){ r "  [FAIL] $*"; FAIL=$((FAIL+1)); }
_warn(){ y "  [WARN] $*"; WARN=$((WARN+1)); }

cmd_check(){
  c "System Hardening Audit"
  echo ""
  c "=== SSH Configuration ==="
  local sshd="/etc/ssh/sshd_config"
  if [ -f "$sshd" ]; then
    grep -qi "^PermitRootLogin no" "$sshd" 2>/dev/null && _ok "Root login disabled" || _fail "Root login NOT disabled"
    grep -qi "^PasswordAuthentication no" "$sshd" 2>/dev/null && _ok "Password auth disabled (key-only)" || _warn "Password auth enabled"
    grep -qi "^X11Forwarding no" "$sshd" 2>/dev/null && _ok "X11 forwarding disabled" || _warn "X11 forwarding enabled"
    grep -qi "^MaxAuthTries" "$sshd" 2>/dev/null && _ok "MaxAuthTries configured" || _warn "MaxAuthTries not set"
    grep -qi "^Protocol 2" "$sshd" 2>/dev/null && _ok "SSH Protocol 2 only" || _ok "Protocol 2 (default in modern SSH)"
  else
    _warn "sshd_config not found"
  fi

  echo ""
  c "=== Firewall ==="
  if command -v ufw >/dev/null 2>&1; then
    sudo ufw status 2>/dev/null | grep -qi active && _ok "UFW active" || _fail "UFW not active"
  elif command -v iptables >/dev/null 2>&1; then
    local rules=$(sudo iptables -L INPUT 2>/dev/null | wc -l)
    [ "$rules" -gt 3 ] && _ok "iptables has $((rules-2)) INPUT rules" || _warn "iptables has minimal rules"
  else
    _fail "No firewall detected"
  fi

  echo ""
  c "=== System Updates ==="
  if command -v apt >/dev/null 2>&1; then
    # grep -c prints 0 AND exits 1 on no match; a `|| echo 0` would append a
    # second line, breaking the integer test below. Just take grep's own count.
    local upgradable; upgradable=$(apt list --upgradable 2>/dev/null | grep -c upgradable); upgradable=${upgradable:-0}
    [ "$upgradable" -le 0 ] && _ok "System up to date" || _warn "$upgradable packages need updating"
  fi

  echo ""
  c "=== File Permissions ==="
  [ "$(stat -c %a /etc/shadow 2>/dev/null)" = "640" ] || [ "$(stat -c %a /etc/shadow 2>/dev/null)" = "600" ] && _ok "/etc/shadow: $(stat -c %a /etc/shadow)" || _fail "/etc/shadow permissions: $(stat -c %a /etc/shadow 2>/dev/null)"
  [ "$(stat -c %a /etc/passwd 2>/dev/null)" = "644" ] && _ok "/etc/passwd: 644" || _warn "/etc/passwd: $(stat -c %a /etc/passwd 2>/dev/null)"
  local world_writable=$(find /etc -perm -o+w -type f 2>/dev/null | wc -l)
  [ "$world_writable" -eq 0 ] && _ok "No world-writable files in /etc" || _fail "$world_writable world-writable files in /etc"

  echo ""
  c "=== Services ==="
  for svc in avahi-daemon cups telnet.socket rpcbind; do
    systemctl is-active --quiet "$svc" 2>/dev/null && _warn "Unnecessary service running: $svc" || _ok "$svc not running"
  done

  echo ""
  c "=== Audit Logging ==="
  systemctl is-active --quiet auditd 2>/dev/null && _ok "auditd running" || _warn "auditd not running"
  command -v fail2ban-client >/dev/null 2>&1 && { fail2ban-client status 2>/dev/null | grep -q "Number of jail" && _ok "fail2ban active" || _warn "fail2ban not active"; } || _warn "fail2ban not installed"

  echo ""
  c "=== Summary ==="
  g "  Passed: $PASS"
  [ "$WARN" -gt 0 ] && y "  Warnings: $WARN"
  [ "$FAIL" -gt 0 ] && r "  Failed: $FAIL"
  echo ""
  [ "$FAIL" -gt 0 ] && echo "  Run 'darknode-harden apply' to fix critical issues."
}

cmd_apply(){
  c "Applying hardening..."
  r "This modifies system configuration. Run with sudo."
  echo ""
  cmd_ssh
  cmd_firewall
  cmd_audit
  g "Hardening applied. Re-run 'darknode-harden check' to verify."
}

cmd_ssh(){
  c "Hardening SSH..."
  local sshd="/etc/ssh/sshd_config"
  [ -f "$sshd" ] || { r "sshd_config not found"; return 1; }
  sudo cp "$sshd" "${sshd}.bak.$(date +%s)"
  sudo sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' "$sshd"
  sudo sed -i 's/^#*X11Forwarding.*/X11Forwarding no/' "$sshd"
  sudo sed -i 's/^#*MaxAuthTries.*/MaxAuthTries 3/' "$sshd"
  sudo sed -i 's/^#*ClientAliveInterval.*/ClientAliveInterval 300/' "$sshd"
  sudo sed -i 's/^#*ClientAliveCountMax.*/ClientAliveCountMax 2/' "$sshd"
  sudo systemctl reload sshd 2>/dev/null || sudo systemctl reload ssh 2>/dev/null
  g "SSH hardened."
}

cmd_firewall(){
  c "Configuring firewall..."
  if command -v ufw >/dev/null 2>&1; then
    sudo ufw default deny incoming 2>/dev/null
    sudo ufw default allow outgoing 2>/dev/null
    sudo ufw allow ssh 2>/dev/null
    sudo ufw --force enable 2>/dev/null
    g "UFW enabled with default deny."
  else
    sudo iptables -P INPUT DROP 2>/dev/null
    sudo iptables -P FORWARD DROP 2>/dev/null
    sudo iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null
    sudo iptables -A INPUT -p tcp --dport 22 -j ACCEPT 2>/dev/null
    sudo iptables -A INPUT -i lo -j ACCEPT 2>/dev/null
    g "iptables configured with default deny."
  fi
}

cmd_audit(){
  c "Setting up audit logging..."
  if command -v auditctl >/dev/null 2>&1; then
    sudo systemctl enable auditd 2>/dev/null && sudo systemctl start auditd 2>/dev/null
    sudo auditctl -w /etc/shadow -p rwa -k shadow_access 2>/dev/null
    sudo auditctl -w /etc/passwd -p wa -k passwd_changes 2>/dev/null
    sudo auditctl -w /etc/sudoers -p wa -k sudoers_changes 2>/dev/null
    g "Audit rules configured."
  else
    y "auditd not installed. apt install auditd"
  fi
  if command -v fail2ban-client >/dev/null 2>&1; then
    sudo systemctl enable fail2ban 2>/dev/null && sudo systemctl start fail2ban 2>/dev/null
    g "fail2ban enabled."
  else
    y "fail2ban not installed. apt install fail2ban"
  fi
}

cmd_report(){
  c "Hardening Report"
  mkdir -p "$HOME/.darknode"
  cmd_check 2>&1 | tee "$HOME/.darknode/harden-report-$(date +%Y%m%d).txt"
  g "Report saved: $HOME/.darknode/harden-report-$(date +%Y%m%d).txt"
}

usage(){
  cat << 'EOF'

  darknode-harden — system hardening automation

  Commands:
    check       Audit current hardening state
    apply       Apply all hardening fixes
    ssh         Harden SSH configuration
    firewall    Configure firewall (UFW/iptables)
    audit       Setup auditd + fail2ban
    report      Generate hardening report

EOF
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  check)    cmd_check ;;
  apply)    cmd_apply ;;
  ssh)      cmd_ssh ;;
  firewall) cmd_firewall ;;
  audit)    cmd_audit ;;
  report)   cmd_report ;;
  help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
