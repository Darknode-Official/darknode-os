# Darknode OS login shell environment
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PS1='\033[1;36mdarknode\033[0m:\033[1;34m\w\033[0m# '
export PAGER=more

alias ll='ls -lah'
alias l='ls -la'
alias ipa='ip -o addr | awk '"'"'{printf "%-10s %-5s %s\n", $2, $3, $4}'"'"''
alias ports='netstat -tulpn 2>/dev/null'

# Show the tour hint once per boot
[ -f /run/.greeted ] || { echo "Kernel: $(uname -sr)   Uptime: $(cut -d. -f1 /proc/uptime)s   Memory: $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)"; echo; : > /run/.greeted; }
