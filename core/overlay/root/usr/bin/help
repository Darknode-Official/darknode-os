#!/bin/sh
# Darknode OS - built-in command reference. Columns align at 80 columns.
echo
echo "  Darknode OS - available commands"
echo "  --------------------------------"
printf "  %-28s %s\n" "darknode"                  "system summary and tour"
printf "  %-28s %s\n" "neofetch"                  "one-line system fingerprint"
printf "  %-28s %s\n" "help"                      "this command list"
printf "  %-28s %s\n" "clear / cls"               "clear the screen"
printf "  %-28s %s\n" "ps / top"                  "real running processes"
printf "  %-28s %s\n" "ip / ifconfig / netstat"   "networking"
printf "  %-28s %s\n" "mount / df / free / lsmod" "system state"
printf "  %-28s %s\n" "vi / less / grep / sed / awk" "editing and text"
printf "  %-28s %s\n" "wget / nc / ping"          "network tools"
printf "  %-28s %s\n" "exit"                      "fresh login shell (does not power off)"
printf "  %-28s %s\n" "poweroff"                  "shut the machine down cleanly"
echo
echo "  Every applet is real BusyBox - run 'busybox --list' for all $(busybox --list 2>/dev/null | wc -l)."
echo "  Edit /etc/profile to add your own aliases and prompt."
echo
