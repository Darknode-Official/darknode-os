#!/bin/sh
# Darknode OS tour / system summary
. /etc/os-release 2>/dev/null
echo
echo "  $PRETTY_NAME"
echo "  ---------------------------------------------"
echo "  Kernel     : $(uname -sr) ($(uname -m))"
echo "  CPU        : $(grep -c ^processor /proc/cpuinfo) core(s) - $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //')"
echo "  Memory     : $(awk '/MemTotal/{printf "%d MB total", $2/1024}' /proc/meminfo), $(awk '/MemAvailable/{printf "%d MB free", $2/1024}' /proc/meminfo)"
echo "  Uptime     : $(cut -d. -f1 /proc/uptime)s"
echo "  Network    :"
ip -o addr 2>/dev/null | awk '{printf "               %-10s %-5s %s\n", $2, $3, $4}'
echo "  Userland   : BusyBox $(busybox 2>&1 | head -1 | awk '{print $2}') (static), $(busybox --list 2>/dev/null | wc -l) applets"
echo "  ---------------------------------------------"
echo "  This is a genuine Linux system: real processes (see 'ps'),"
echo "  real networking stack, real filesystem. Built from mainline"
echo "  kernel source + BusyBox. 'help' lists what you can run."
echo
