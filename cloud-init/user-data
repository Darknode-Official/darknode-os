#cloud-config
# Darknode OS — a unique, from-scratch security workstation on a neutral Debian
# base. Its own desktop + curated toolset + local-AI autonomy + the Darknode app
# as the UI cockpit. No Kali packages. Everything installs on first boot.
hostname: darknode-os
users:
  - name: darknode
    gecos: Darknode Operator
    groups: [sudo, kvm]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: false
    passwd: "REPLACED_AT_BUILD_TIME"
chpasswd:
  expire: false
ssh_pwauth: true
package_update: true

write_files:
  - path: /etc/lightdm/lightdm.conf.d/10-darknode-autologin.conf
    content: |
      [Seat:*]
      autologin-user=darknode
      autologin-user-timeout=0
      user-session=darknode
  # A session that guarantees a D-Bus session bus (dbus-run-session) — the minimal
  # cloud base doesn't export DBUS_SESSION_BUS_ADDRESS into the autologin session,
  # which otherwise breaks xfce4-session ("unable to load a failsafe session").
  - path: /usr/share/xsessions/darknode.desktop
    content: |
      [Desktop Entry]
      Name=Darknode Desktop
      Comment=Darknode XFCE session (guaranteed D-Bus)
      Exec=dbus-run-session -- startxfce4
      Type=Application
      DesktopNames=XFCE
  - path: /etc/motd
    content: |

      ########     ###    ########  ##    ## ##    ##  #######  ########  ########
      ##     ##   ## ##   ##     ## ##   ##  ###   ## ##     ## ##     ## ##
      ##     ##  ##   ##  ##     ## ##  ##   ####  ## ##     ## ##     ## ##
      ##     ## ##     ## ########  #####    ## ## ## ##     ## ##     ## ######
      ##     ## ######### ##   ##   ##  ##   ##  #### ##     ## ##     ## ##
      ##     ## ##     ## ##    ##  ##   ##  ##   ### ##     ## ##     ## ##
      ########  ##     ## ##     ## ##    ## ##    ##  #######  ########  ########
        Darknode OS · agentic security workstation · `darknode nexus` / Autopilot

  # The Darknode app is optional (in the menu / on the desktop) — it does NOT
  # auto-launch. The VM's UI is its own branded XFCE desktop. This autostart only
  # applies the Darknode wallpaper + dark theme once, then removes itself.
  - path: /home/darknode/.config/autostart/darknode-desktop-setup.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=Darknode Desktop Setup
      Exec=darknode-desktop-setup
      X-GNOME-Autostart-enabled=true
    owner: darknode:darknode
    defer: true
  # (Firefox default homepage = the Darknode web console is set via autoconfig in
  # provision.sh — a user-CHANGEABLE default with no "managed by your org" banner.
  # A policy is deliberately NOT used so Google + all Firefox settings stay editable.)
  - path: /usr/local/bin/darknode-autopilot
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Autonomous hacking: a local AI agent plans + runs recon/exploitation toward
      # a goal, using a free local model (Ollama) — offline, no API key. Authorized
      # targets only.
      set -u
      if command -v ollama >/dev/null; then
        pgrep -x ollama >/dev/null || (nohup ollama serve >/dev/null 2>&1 &)
        for _i in $(seq 1 20); do ollama list >/dev/null 2>&1 && break; sleep 1; done
        ollama list 2>/dev/null | grep -qiE "llama3|qwen|mistral" || { echo "[*] pulling a local model (one-time)…"; ollama pull llama3.2:3b || true; }
      fi
      echo "== Darknode Autopilot — autonomous AI hacking =="
      echo "  1) Autonomous recon on a target   (darknode-agent: OSINT -> recon -> AI report)"
      echo "  2) Freeform AI hacking goal        (Nexus autonomous run)"
      echo "  3) Persistent mission              (darknode-autonomy: pursue a goal on a schedule)"
      read -rp "choose [1/2/3]: " MODE
      case "${MODE:-1}" in
        3) command -v darknode-autonomy >/dev/null || { echo "darknode-autonomy not installed"; exit 1; }
           read -rp "Mission name: " MN; read -rp "Goal: " GOAL
           read -rp "Scope target (blank = freeform): " SC
           read -rp "Mode [monitor/passive/active/goal] (default passive): " MM
           read -rp "Every [e.g. 6h/1d] (default 6h): " EV
           [ -n "$MN" ] && [ -n "$GOAL" ] || { echo "need a name and goal"; exit 1; }
           darknode-autonomy add "$MN" --goal "$GOAL" ${SC:+--scope "$SC"} --mode "${MM:-passive}" --every "${EV:-6h}"
           echo; read -rp "Run it now? [Y/n]: " GO; case "${GO:-y}" in n*|N*) : ;; *) darknode-autonomy once "$MN";; esac
           echo; echo "Make it persistent across reboots:  darknode-autonomy enable"; exit 0 ;;
        2) read -rp "Goal (e.g. 'recon and exploit 10.0.0.5 for a shell'): " GOAL
           [ -n "$GOAL" ] || { echo "no goal given"; exit 1; }
           exec darknode nexus run "$GOAL" -e ollama ;;
        *) read -rp "Target (ip or domain): " TGT
           [ -n "$TGT" ] || { echo "no target"; exit 1; }
           exec darknode-agent "$TGT" ;;
      esac
  - path: /usr/local/sbin/darknode-provision.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -ux
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
      LOG=/var/log/darknode-provision.log; exec >>"$LOG" 2>&1
      echo "=== Darknode provision $(date) ==="
      apt-get remove -y needrestart 2>/dev/null || true
      # Which base are we wearing? build.sh stamps the family; fall back to os-release
      # so this works whatever apt distro (Debian / Ubuntu / Kali) it lands on.
      FAMILY="@@DARKNODE_FAMILY@@"
      case "$FAMILY" in debian|ubuntu) : ;; *)
        . /etc/os-release 2>/dev/null || true
        case "${ID:-debian} ${ID_LIKE:-}" in *ubuntu*) FAMILY=ubuntu;; *) FAMILY=debian;; esac ;;
      esac
      echo "== Darknode base family: $FAMILY (${PRETTY_NAME:-unknown}) =="
      # Which EDITION are we building? build.sh stamps it. Controls how much ships:
      #   netinstall — terminal only, no desktop/UI, core CLI + Nexus + local AI (smallest)
      #   slim       — full desktop + Nexus + tools, minus the multi-GB frameworks/app
      #   full       — everything: desktop, cockpit app, Metasploit, SecLists, Docker
      EDITION="@@DARKNODE_EDITION@@"
      case "$EDITION" in netinstall|slim|full) : ;; *) EDITION=full ;; esac
      case "$EDITION" in
        netinstall) WANT_GUI=0; WANT_APP=0; WANT_HEAVY=0 ;;
        slim)       WANT_GUI=1; WANT_APP=0; WANT_HEAVY=0 ;;
        *)          WANT_GUI=1; WANT_APP=1; WANT_HEAVY=1 ;;
      esac
      echo "== Darknode edition: $EDITION  (gui=$WANT_GUI app=$WANT_APP heavy=$WANT_HEAVY) =="
      # Rebrand the OS identity to Darknode OS 1.0 (display fields only). This makes
      # os-release, neofetch and the console/SSH login banner say Darknode instead of
      # the apt base. ID / ID_LIKE / VERSION_ID / codenames are kept untouched so apt
      # and base-distro tooling still resolve correctly. Runs after family detection,
      # which already captured ID above, so this can't affect it.
      if [ -f /etc/os-release ]; then
        sed -i -E 's/^NAME=.*/NAME="Darknode OS"/; s/^PRETTY_NAME=.*/PRETTY_NAME="Darknode OS 1.0"/; s#^HOME_URL=.*#HOME_URL="https://darknode.ai"#' /etc/os-release
        grep -q '^NAME='        /etc/os-release || echo 'NAME="Darknode OS"'        >> /etc/os-release
        grep -q '^PRETTY_NAME=' /etc/os-release || echo 'PRETTY_NAME="Darknode OS 1.0"' >> /etc/os-release
        grep -q '^VARIANT='     /etc/os-release || echo 'VARIANT="Darknode OS 1.0"'     >> /etc/os-release
      fi
      { echo "Darknode OS 1.0"; echo; } > /etc/issue    2>/dev/null || true
      echo "Darknode OS 1.0"            > /etc/issue.net 2>/dev/null || true
      if [ "$FAMILY" = ubuntu ]; then
        # Ubuntu: make sure universe/multiverse are on (most tools live there)
        (command -v add-apt-repository >/dev/null && add-apt-repository -y universe multiverse) 2>/dev/null || \
          sed -i 's/^Components: .*/Components: main restricted universe multiverse/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
      else
        # Debian/Kali: enable contrib/non-free (old sources.list AND deb822 debian.sources)
        sed -i 's/ main$/ main contrib non-free non-free-firmware/' /etc/apt/sources.list 2>/dev/null || true
        sed -i '/^Components:/ s/$/ contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true
      fi
      apt-get update -y || true
      # Full generic kernel (has vboxvideo/vboxguest + HID/SATA drivers) so the VM works
      # in VirtualBox/VMware, not just virtio-cloud — cursor + graphics need it. The
      # package name differs per distro; the cloud/minimal kernel is then removed.
      if [ "$FAMILY" = ubuntu ]; then
        apt-get install -y linux-generic && { apt-get purge -y linux-image-kvm linux-kvm 2>/dev/null || true; }
      else
        apt-get install -y linux-image-amd64 && { apt-get purge -y linux-image-cloud-amd64 2>/dev/null || true; }
      fi
      update-grub 2>/dev/null || true
      # Clone the darknode-os-distro repo (boot themes, desktop entries, wallpapers,
      # toolkit). NOTE: this is darknode-os-distro, NOT darknode-os (which is the
      # from-scratch research kernel and has none of this content).
      [ -d /opt/darknode-os ] || timeout 300 git clone --depth 1 https://github.com/Darknode-Official/darknode-os-distro /opt/darknode-os 2>/dev/null || true
      # Copy wallpapers from local clone (faster than downloading each one)
      if [ -d /opt/darknode-os/toolkit/wallpapers ]; then
        install -d /usr/share/backgrounds/darknode
        cp /opt/darknode-os/toolkit/wallpapers/*.png /usr/share/backgrounds/darknode/ 2>/dev/null || true
      fi
      # ---- Darknode GRUB theme ----
      mkdir -p /boot/grub/themes/darknode
      cp /opt/darknode-os/boot/grub-theme/theme.txt /boot/grub/themes/darknode/ 2>/dev/null
      if [ -f /boot/grub/themes/darknode/theme.txt ]; then
        sed -i 's|^#*GRUB_THEME=.*|GRUB_THEME="/boot/grub/themes/darknode/theme.txt"|' /etc/default/grub
        grep -q GRUB_THEME /etc/default/grub || echo 'GRUB_THEME="/boot/grub/themes/darknode/theme.txt"' >> /etc/default/grub
        update-grub 2>/dev/null
      fi
      # ---- Plymouth boot splash ----
      apt-get install -y plymouth plymouth-themes 2>/dev/null || true
      mkdir -p /usr/share/plymouth/themes/darknode
      cp /opt/darknode-os/boot/plymouth/darknode/* /usr/share/plymouth/themes/darknode/ 2>/dev/null
      if [ -d /usr/share/plymouth/themes/darknode ] && command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme darknode 2>/dev/null
        sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/' /etc/default/grub
        update-initramfs -u 2>/dev/null || true
        update-grub 2>/dev/null
      fi
      echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections
      # Our own desktop (XFCE) + tools from Debian — installed one-by-one so a
      # single unavailable package can't abort the batch.
      # CORE — CLI security stack + runtimes, shipped in EVERY edition (incl. netinstall).
      PKGS_CORE="git curl wget jq unzip build-essential python3 python3-pip pipx nodejs npm \
        nmap masscan dnsutils whois net-tools tcpdump \
        nikto whatweb wafw00f dnsrecon dirb wfuzz gobuster \
        sqlmap hydra john hashcat aircrack-ng \
        radare2 binwalk foremost sleuthkit \
        netcat-traditional python3-impacket \
        tor nftables firejail firejail-profiles apparmor apparmor-utils macchanger \
        proxychains4 torsocks gnupg whiptail kbd libglib2.0-bin \
        tshark ngrep hping3 netdiscover nbtscan smbclient enum4linux \
        onesixtyone snmp sslscan arpwatch socat rlwrap \
        medusa ncrack cewl crunch wordlists \
        kismet pixiewps reaver wifite \
        yara clamav gdb strace ltrace hexedit libimage-exiftool-perl \
        tmux screen vim neovim zsh fzf ripgrep bat htop \
        ruby ruby-dev libssl-dev libffi-dev \
        awscli python3-boto3 \
        autopsy testdisk scalpel dc3dd ewf-tools \
        theharvester recon-ng spiderfoot \
        responder crackmapexec evil-winrm \
        ffuf feroxbuster subfinder amass nuclei httpx \
        zaproxy wpscan arjun \
        chisel ligolo-ng pwncat \
        seclists payloadsallthethings fuzzdb \
        ettercap-text-only mitmproxy bettercap yersinia netsniff-ng dnschef sslstrip         commix xsser dirsearch         hashid hash-identifier ophcrack chntpw patator         bully cowpatty         volatility3 bulk-extractor oletools afflib-tools         apktool dex2jar upx-ucl patchelf checksec         sshuttle impacket-scripts metagoofil         searchsploit shellnoob routersploit \
        dnsenum fierce dnsmap dsniff tcpreplay tcpflow         mdk3 mdk4 hostapd         openvpn wireguard-tools         p7zip-full dos2unix tree fd-find exa         hashdeep ddrescue         zmap unicornscan         eyewitness         sublist3r         set jwt-tool nosqlmap graphqlmap ldap-utils samba-common-bin finger"
      # DESKTOP — XFCE + GUI tools, added for slim & full (not netinstall).
      PKGS_DESKTOP="xfce4 xfce4-terminal xfce4-goodies xfce4-whiskermenu-plugin lightdm dbus-x11 \
        wireshark ettercap-graphical keepassxc desktop-file-utils \
        xdotool wmctrl libimage-exiftool-perl arc-theme papirus-icon-theme \
        fonts-inter fonts-jetbrains-mono dmz-cursor-theme xfce4-notifyd"
      # HEAVY — multi-GB extras, full only.
      PKGS_HEAVY="docker.io docker-compose-plugin"
      PKGS="$PKGS_CORE"
      [ "$WANT_GUI" = 1 ]   && PKGS="$PKGS $PKGS_DESKTOP"
      [ "$WANT_HEAVY" = 1 ] && PKGS="$PKGS $PKGS_HEAVY"
      for p in $PKGS; do apt-get install -y "$p" || echo "SKIP $p"; done
      if [ "$WANT_HEAVY" = 1 ]; then usermod -aG docker darknode 2>/dev/null || true; systemctl enable --now docker 2>/dev/null || true; fi
      [ "$WANT_GUI" = 1 ] && usermod -aG wireshark darknode 2>/dev/null || true
      # ---- upstream tools (not in Debian) ----
      install -d -m0755 /usr/share/keyrings
      if [ "$WANT_HEAVY" = 1 ]; then
        # Metasploit (official installer adds its apt repo) — full only (multi-GB)
        curl -fsSL --max-time 60 https://apt.metasploit.com/metasploit-framework.gpg.key | gpg --dearmor -o /usr/share/keyrings/metasploit.gpg 2>/dev/null || true
        echo "deb [signed-by=/usr/share/keyrings/metasploit.gpg] https://apt.metasploit.com/ lucid main" > /etc/apt/sources.list.d/metasploit.list
        apt-get update -y || true
        timeout 900 apt-get install -y metasploit-framework || echo "MSF-SKIP"
        # SecLists + Exploit-DB (searchsploit) — large wordlist/exploit corpora
        [ -d /usr/share/seclists ] || timeout 400 git clone --depth 1 https://github.com/danielmiessler/SecLists /usr/share/seclists || echo SECLISTS-SKIP
        [ -d /opt/exploitdb ] || timeout 300 git clone --depth 1 https://gitlab.com/exploit-database/exploitdb /opt/exploitdb || echo EDB-SKIP
        ln -sf /opt/exploitdb/searchsploit /usr/local/bin/searchsploit 2>/dev/null || true
      fi
      # ProjectDiscovery + ffuf via PREBUILT release binaries (no compile, no Go-version issues)
      mkdir -p /tmp/pd
      for repo in projectdiscovery/nuclei projectdiscovery/subfinder projectdiscovery/httpx ffuf/ffuf; do
        url=$(curl -fsSL --max-time 30 "https://api.github.com/repos/$repo/releases/latest" | jq -r '.assets[].browser_download_url' | grep -iE 'linux_amd64\.(zip|tar\.gz)$' | grep -viE 'arm|386|sdk' | head -1)
        [ -n "$url" ] || { echo "PDSKIP $repo"; continue; }
        curl -fsSL --max-time 120 -o /tmp/pd/a "$url" || { echo "PDSKIP $repo"; continue; }
        case "$url" in *.zip) (cd /tmp/pd && unzip -oq a);; *) tar xzf /tmp/pd/a -C /tmp/pd 2>/dev/null;; esac
        for f in /tmp/pd/*; do [ "$f" = /tmp/pd/a ] && continue; file "$f" 2>/dev/null | grep -q ELF && install -m0755 "$f" /usr/local/bin/; rm -f "$f"; done
        rm -f /tmp/pd/a
      done
      timeout 240 pipx install netexec 2>/dev/null || echo NXC-SKIP; pipx ensurepath 2>/dev/null || true
      # Additional tools via pip/pipx/git (not in apt)
      pipx install xsstrike 2>/dev/null || pip3 install xsstrike 2>/dev/null || true
      pipx install dalfox 2>/dev/null || true
      pip3 install sherlock-project 2>/dev/null || true
      pip3 install photon 2>/dev/null || true
      pip3 install pspy 2>/dev/null || true
      # Git-based tools
      [ -d /opt/linpeas ] || timeout 120 git clone --depth 1 https://github.com/carlospolop/PEASS-ng /opt/linpeas || true
      [ -d /opt/bloodhound ] || timeout 120 git clone --depth 1 https://github.com/BloodHoundAD/BloodHound /opt/bloodhound || true
      [ -d /opt/pacu ] || timeout 120 git clone --depth 1 https://github.com/RhinoSecurityLabs/pacu /opt/pacu || true
      [ -d /opt/prowler ] || timeout 120 git clone --depth 1 https://github.com/prowler-cloud/prowler /opt/prowler || true
      # More tools via pip/git
      pip3 install shodan censys 2>/dev/null || true
      pipx install holehe 2>/dev/null || true
      pipx install maigret 2>/dev/null || true
      pipx install socialscan 2>/dev/null || true
      pip3 install paramspider 2>/dev/null || true
      # Go tools (if go is available)
      if command -v go >/dev/null 2>&1; then
        go install github.com/lc/gau/v2/cmd/gau@latest 2>/dev/null || true
        go install github.com/tomnomnom/waybackurls@latest 2>/dev/null || true
        go install github.com/hakluke/hakrawler@latest 2>/dev/null || true
        go install github.com/projectdiscovery/katana/cmd/katana@latest 2>/dev/null || true
        go install github.com/jaeles-project/gospider@latest 2>/dev/null || true
        go install github.com/sensepost/gowitness@latest 2>/dev/null || true
        go install github.com/RustScan/RustScan@latest 2>/dev/null || true
        cp ~/go/bin/* /usr/local/bin/ 2>/dev/null || true
      fi
      # Sliver C2
      [ -f /opt/sliver ] || timeout 300 bash -c 'curl -fsSL https://sliver.sh/install | bash' 2>/dev/null || true
      # Terraform
      command -v terraform >/dev/null 2>&1 || timeout 120 bash -c 'curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg; echo "deb [signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com bookworm main" > /etc/apt/sources.list.d/hashicorp.list; apt-get update && apt-get install -y terraform' 2>/dev/null || true
      # Trivy
      command -v trivy >/dev/null 2>&1 || timeout 120 bash -c 'curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin' 2>/dev/null || true
      # Local AI for autonomous hacking
      timeout 300 bash -c "curl -fsSL https://ollama.com/install.sh | sh" || echo OLLAMA-SKIP
      systemctl enable --now ollama 2>/dev/null || true
      # Darknode cockpit app (latest .deb) — full only (the GUI cockpit; slim/netinstall
      # use Nexus in the terminal instead). Nexus CLI itself installs in every edition.
      if [ "$WANT_APP" = 1 ]; then
        DEB_URL=$(curl -fsSL https://api.github.com/repos/Darknode-Official/darknode-web/releases/tags/darknode | jq -r '.assets[].browser_download_url' | grep -E 'darknode-app_.*_amd64\.deb' | sort -V | tail -1)
        if [ -n "$DEB_URL" ]; then curl -fL --max-time 180 "$DEB_URL" -o /tmp/darknode-app.deb; apt-get install -y /tmp/darknode-app.deb || { dpkg -i /tmp/darknode-app.deb || true; apt-get -f install -y; }; fi
      fi
      [ -d /opt/darknode-cli ] || timeout 180 git clone --depth 1 https://github.com/Darknode-Official/darknode-cli /opt/darknode-cli
      ( cd /opt/darknode-cli && { timeout 300 npm install --omit=dev --no-audit --no-fund || timeout 300 npm install --no-audit --no-fund || true; }; npm link || ln -sf /opt/darknode-cli/darknode.js /usr/local/bin/darknode )
      chmod +x /opt/darknode-cli/darknode.js || true
      # Bundled MCP tools that ship with Nexus — pre-install their runtimes + packages so
      # they auto-connect instantly (and offline) on first launch. Best-effort; if any of
      # this fails, Nexus just npx/uvx-installs the server the first time it's used.
      command -v uvx >/dev/null 2>&1 || curl -LsSf --max-time 120 https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh || true
      timeout 300 npm install -g @modelcontextprotocol/server-memory @modelcontextprotocol/server-sequential-thinking @upstash/context7-mcp 2>/dev/null || echo "MCP-NPM-SKIP"
      if command -v uv >/dev/null 2>&1; then for pkg in mcp-server-fetch mcp-server-time mcp-server-git; do timeout 180 uv tool install "$pkg" 2>/dev/null || echo "MCP-UVX-SKIP $pkg"; done; fi
      # Darknode toolkit — adopted-and-improved distro features + unique AI tools
      # Install all toolkit scripts from the local clone (resolves symlinks properly)
      if [ -d /opt/darknode-os/toolkit ]; then
        find /opt/darknode-os/toolkit -name 'darknode-*' -type f ! -name '*.png' | while read -r src; do
          name=$(basename "$src")
          cp "$src" "/usr/local/bin/$name" && chmod +x "/usr/local/bin/$name"
        done
        [ -f /opt/darknode-os/toolkit/gen-darknode-menu ] && cp /opt/darknode-os/toolkit/gen-darknode-menu /usr/local/bin/ && chmod +x /usr/local/bin/gen-darknode-menu
        echo "Installed $(ls /usr/local/bin/darknode-* 2>/dev/null | wc -l) toolkit scripts from local clone"
      else
        # Fallback: download individually (won't resolve symlinks but better than nothing)
        for s in darknode-ai darknode-scope darknode-recon darknode-loot \
                 darknode-harvest darknode-agent darknode-greeting \
                 darknode-cheat darknode-watch darknode-catch darknode-crack darknode-pivot darknode-autonomy \
                 darknode-anon darknode-macspoof darknode-detonate darknode-stealth \
                 darknode-ask darknode-triage darknode-engage darknode-arsenal \
                 darknode-tweaks darknode-lockout darknode-tools gen-darknode-menu darknode-desktop-setup; do
          curl -fsSL "https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/$s" -o "/usr/local/bin/$s" && chmod +x "/usr/local/bin/$s" || echo "TOOLKIT-SKIP $s"
        done
      fi
      # `/lockout` shorthand for the defensive lockdown command
      ln -sf /usr/local/bin/darknode-lockout /usr/local/bin/lockout
      # menu entry (non-destructive: shows status + how to engage/restore)
      cat > /usr/share/applications/darknode-lockout.desktop <<'LOCK'
      [Desktop Entry]
      Type=Application
      Name=Darknode Lockout (defense)
      Comment=Emergency defensive lockdown — seal inbound, harden, cut foreign connections
      Exec=xfce4-terminal --title="Darknode Lockout" -e "bash -lc 'sudo lockout status; echo; echo \"Engage:  lockout on     Restore: lockout off\"; exec bash'"
      Icon=security-high
      Terminal=false
      Categories=System;Security;
      LOCK
      sed -i 's/^      //' /usr/share/applications/darknode-lockout.desktop
      command -v firecfg >/dev/null && firecfg >/dev/null 2>&1 || true   # auto-sandbox common apps
      echo darknode >> /etc/firejail/firejail.users 2>/dev/null || true
      if [ "$WANT_GUI" = 1 ]; then
      # ===== desktop-only (slim & full): app menu, wallpapers, browser, login theme, guest additions =====
      gen-darknode-menu 2>/dev/null || true
      install -d /usr/share/backgrounds; curl -fsSL "https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/darknode-wallpaper.png" -o /usr/share/backgrounds/darknode-wallpaper.png 2>/dev/null || true
      # Darknode wallpaper set (50 unique + classic) + the switcher/cycler tool.
      # Fetch the manifest, then pull each listed image — no hardcoded filenames.
      install -d /usr/share/backgrounds/darknode
      WPBASE="https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/wallpapers"
      if curl -fsSL "$WPBASE/manifest.txt" -o /tmp/wp-manifest.txt 2>/dev/null; then
        while read -r wp; do [ -n "$wp" ] || continue
          curl -fsSL "$WPBASE/$wp" -o "/usr/share/backgrounds/darknode/$wp" 2>/dev/null || echo "WALL-SKIP $wp"
        done < /tmp/wp-manifest.txt
      fi
      curl -fsSL "https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/darknode-wallpaper" -o /usr/local/bin/darknode-wallpaper && chmod +x /usr/local/bin/darknode-wallpaper 2>/dev/null || true
      install -d /usr/share/pixmaps; curl -fsSL "https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/google-icon.png" -o /usr/share/pixmaps/darknode-google.png 2>/dev/null || true
      curl -fsSL "https://raw.githubusercontent.com/Darknode-Official/darknode-os-distro/main/toolkit/darknode-menu.png" -o /usr/share/pixmaps/darknode-menu.png 2>/dev/null || true
      # Browser = Google Chrome (Google's own browser: Google homepage, search and
      # new-tab out of the box). Installed from Google's apt repo; set as the default.
      curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg 2>/dev/null || true
      echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list
      apt-get update -qq 2>/dev/null || true
      apt-get install -y google-chrome-stable || echo "CHROME-SKIP"
      update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/google-chrome-stable 200 2>/dev/null || true
      update-alternatives --set x-www-browser /usr/bin/google-chrome-stable 2>/dev/null || true
      # branded LightDM login screen (dark, Darknode wallpaper, teal accent)
      cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'GRE'
      [greeter]
      theme-name = Arc-Dark
      icon-theme-name = Papirus-Dark
      font-name = Inter 11
      cursor-theme-name = DMZ-White
      cursor-theme-size = 24
      background = /usr/share/backgrounds/darknode-wallpaper.png
      xft-antialias = true
      xft-hintstyle = hintslight
      xft-rgba = rgb
      indicators = ~host;~spacer;~clock;~spacer;~session;~power
      clock-format = %A  %d %B    %H:%M
      position = 50%,center 58%,center
      GRE
      sed -i 's/^      //' /etc/lightdm/lightdm-gtk-greeter.conf
      # VirtualBox Guest Additions — auto-resize the display so fullscreen fills the
      # screen with NO black bars, plus shared clipboard. Built against the generic
      # kernel from the Debian GA-ISO package (VBox guest .debs are gone from bookworm).
      # Harmless under QEMU/KVM — the modules simply stay idle there.
      apt-get install -y linux-headers-amd64 dkms virtualbox-guest-additions-iso 2>/dev/null || true
      GAISO=$(ls /usr/share/virtualbox/VBoxGuestAdditions.iso 2>/dev/null | head -1)
      if [ -n "$GAISO" ]; then
        mkdir -p /mnt/ga && mount -o loop,ro "$GAISO" /mnt/ga 2>/dev/null && \
          { sh /mnt/ga/VBoxLinuxAdditions.run --nox11 2>/dev/null || true; umount /mnt/ga 2>/dev/null; }
      fi
      fi   # ===== end desktop-only (WANT_GUI) =====
      # Make the image bootable on ANY hypervisor disk controller (VirtualBox
      # SATA/AHCI, VMware) — the Debian cloud initramfs is virtio-only by default.
      sed -i 's/^MODULES=.*/MODULES=most/' /etc/initramfs-tools/initramfs.conf 2>/dev/null || echo "MODULES=most" >> /etc/initramfs-tools/initramfs.conf
      update-initramfs -u 2>/dev/null || true
      if [ "$WANT_GUI" = 1 ]; then
      # Desktop cockpit shortcuts (slim & full)
      install -d -o darknode -g darknode /home/darknode/Desktop
      if [ "$WANT_APP" = 1 ]; then
      cat > /home/darknode/Desktop/Darknode.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Darknode (cockpit)
      Icon=utilities-system-monitor
      Exec=darknode-app
      Terminal=false
      D
      fi
      cat > /home/darknode/Desktop/Autopilot.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Darknode Autopilot
      Comment=Autonomous AI hacking — give a goal, the local agent runs it
      Exec=xfce4-terminal --title="Darknode Autopilot" -e darknode-autopilot
      Icon=system-run
      Terminal=false
      D
      cat > /home/darknode/Desktop/Autonomy.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Darknode Autonomy
      Comment=Persistent mission engine — the local AI pursues your goals on a schedule
      Exec=xfce4-terminal --title="Darknode Autonomy" -e "bash -lc 'darknode-autonomy list; echo; echo \"add:  darknode-autonomy add <name> --goal \\\"...\\\" [--scope t] [--mode monitor|passive|active|goal] [--every 6h]\"; echo \"run persistently:  darknode-autonomy enable\"; exec bash'"
      Icon=appointment-recurring
      Terminal=false
      D
      cat > /home/darknode/Desktop/Darknode-Tweaks.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Darknode Tweaks
      Comment=Control center — anon mode, stealth, MAC spoof, arsenals, AI triage
      Exec=xfce4-terminal --title="Darknode Tweaks" -e darknode-tweaks
      Icon=applications-utilities
      Terminal=false
      D
      chown darknode:darknode /home/darknode/Desktop/*.desktop 2>/dev/null || true
      chmod +x /home/darknode/Desktop/*.desktop 2>/dev/null || true
      # Install Darknode app desktop entries into the system menu
      for df in /opt/darknode-os/desktop/*.desktop; do
        [ -f "$df" ] && cp "$df" /usr/share/applications/ 2>/dev/null
      done
      fi   # end desktop cockpit shortcuts (WANT_GUI)
      # Branded shell: a Darknode banner on new terminals + a teal Darknode prompt
      if ! grep -q "darknode-greeting" /home/darknode/.bashrc 2>/dev/null; then
        cat >> /home/darknode/.bashrc <<'BRC'
      # --- Darknode branding ---
      [ -n "$PS1" ] && command -v darknode-greeting >/dev/null && darknode-greeting
      export PS1='\[\e[38;5;44m\]\u@darknode\[\e[0m\]:\[\e[38;5;231m\]\w\[\e[38;5;44m\]$\[\e[0m\] '
      BRC
      fi
      # cloud-init write_files ran as root and left parts of the home root-owned
      # (esp. ~/.config), which breaks xfconfd -> the XFCE session. Fix ownership.
      chown -R darknode:darknode /home/darknode
      # MAC-agnostic network so it works in VirtualBox/any hypervisor (the default
      # cloud netplan pins a MAC), and stop cloud-init from regenerating it.
      printf 'network:\n  version: 2\n  ethernets:\n    darknode-any:\n      match:\n        name: "e*"\n      dhcp4: true\n      dhcp6: false\n' > /etc/netplan/50-cloud-init.yaml
      chmod 600 /etc/netplan/50-cloud-init.yaml
      echo 'network: {config: disabled}' > /etc/cloud/cloud.cfg.d/99-disable-network.cfg
      # Boot target per edition: GUI editions bring up the LightDM desktop; netinstall
      # is terminal-only — boot to the console and autologin the operator on tty1.
      if [ "$WANT_GUI" = 1 ]; then
        systemctl enable lightdm 2>/dev/null || true
        systemctl set-default graphical.target 2>/dev/null || true
        systemctl start lightdm 2>/dev/null || true
      else
        systemctl disable lightdm 2>/dev/null || true
        systemctl set-default multi-user.target 2>/dev/null || true
        mkdir -p /etc/systemd/system/getty@tty1.service.d
        printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin darknode --noclear %%I $TERM\n' > /etc/systemd/system/getty@tty1.service.d/autologin.conf
        systemctl daemon-reload 2>/dev/null || true
        systemctl restart getty@tty1 2>/dev/null || true
      fi
      touch /var/lib/darknode-provisioned
      echo "=== provision done $(date) ==="

runcmd:
  - [ bash, -c, "echo 'datasource_list: [ NoCloud, ConfigDrive, None ]' > /etc/cloud/cloud.cfg.d/99-nocloud.cfg" ]
  # provision.sh sets the boot target itself (graphical for slim/full, console for netinstall)
  - [ bash, /usr/local/sbin/darknode-provision.sh ]

final_message: "Darknode OS ready after $UPTIME s. Login: darknode / darknode."
